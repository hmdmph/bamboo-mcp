BAMBOO_URL=https://bamboo.example.com
BAMBOO_TOKEN=your_bamboo_token_here
BAMBOO_PROXY=
VERBOSE=true
CONTEXT_FILE=              # Optional: custom path to context.yaml (default: ~/.bamboo-mcp/context.yaml)

# Transport: stdio (default, for Claude Desktop/Cursor) or sse (for HTTP/containers)
MCP_TRANSPORT=stdio

# SSE/HTTP transport settings (only used when MCP_TRANSPORT=sse)
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=8080
MCP_BASE_URL=http://localhost:8080

# Skip startup validation checks (useful if Bamboo is temporarily unreachable)
SKIP_VALIDATION=false

# Security configuration file path (default: ~/.bamboo-mcp/security.yaml)
# Auto-created with safe defaults on first run
SECURITY_FILE=
